# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*

# Local scratch directories
.tmp/
tmp/
C%3A/
/gpt_need/

# KeYmaera X is an optional external dependency.  Do not publish the jar,
# per-user database/configuration, or generated proof evidence with the code.
tools/keymaerax.jar
tools/*.zip
keymaerax.jar
.keymaerax-home/
.keymaerax-artifacts/
keymaerax-artifacts/
*.kyp

# Local research material and historical audit notes stay on the developer
# machine.  Current public documentation lives in the root README and
# document/; these patterns only exclude papers, slide decks, and root-level
# scratch reports.
*.pdf
*.pptx
/GETTING_STARTED.md
/*_AUDIT.md
/TEST_*.md
*/README.md
